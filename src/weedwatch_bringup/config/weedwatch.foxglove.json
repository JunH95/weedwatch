  "layout": {
    "first": {
      "first": "3D!main",
      "second": { "first": "Image!cam0", "second": "Image!cam1", "direction": "column" },
      "direction": "row",
      "splitPercentage": 62
    },
    "second": {
      "first": "Plot!loc",
      "second": { "first": "Plot!heading", "second": "Plot!weeds", "direction": "row" },
      "direction": "column",
      "splitPercentage": 45
