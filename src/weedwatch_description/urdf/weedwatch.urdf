<?xml version="1.0"?>
<robot name="weedwatch">

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="model://weedwatch_robot/base.obj"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.0000 0.6000 0.4700" rpy="0 0 0"/>
      <geometry><box size="1.3000 0.2200 0.4200"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.0000 -0.6000 0.4700" rpy="0 0 0"/>
      <geometry><box size="1.3000 0.2200 0.4200"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.0000 0.0000 0.6950" rpy="0 0 0"/>
      <geometry><box size="1.3000 1.4000 0.0300"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.198109 0.000000 0.441994" rpy="0 0 0"/>
      <mass value="22.0000"/>
      <inertia ixx="7.9186171" iyy="3.2890499" izz="10.411766" ixy="0" ixz="0.39222959" iyz="0"/>
    </inertial>
  </link>

  <link name="wheel_fl">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="model://weedwatch_robot/wheel_fl.obj"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.1100" length="0.0800"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.000000 0.000000 0.000000" rpy="0 0 0"/>
      <mass value="2.5000"/>
      <inertia ixx="0.0088958333" iyy="0.015125" izz="0.0088958333" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="wheel_fl_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_fl"/>
    <origin xyz="0.50000 -0.61244 0.11000" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_fr">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="model://weedwatch_robot/wheel_fr.obj"/></geometry>
    </visual>
    <collision>
