      <mass value="2.5000"/>
      <inertia ixx="0.0088958333" iyy="0.015125" izz="0.0088958333" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="wheel_rl_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rl"/>
    <origin xyz="-0.50000 -0.61244 0.11000" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_rr">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="model://weedwatch_robot/wheel_rr.obj"/></geometry>
