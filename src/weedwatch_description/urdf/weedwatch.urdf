      <inertia ixx="0.0088958333" iyy="0.015125" izz="0.0088958333" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="wheel_rr_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rr"/>
    <origin xyz="-0.50000 0.61244 0.11000" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="carriage0">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="model://weedwatch_robot/carriage0.obj"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.0000 0.0000 0.0000" rpy="0 0 0"/>
      <geometry><box size="0.1400 0.1000 0.1000"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.000000 0.000000 0.000000" rpy="0 0 0"/>
      <mass value="2.0000"/>
      <inertia ixx="0.0033333333" iyy="0.0049333333" izz="0.0049333333" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="carriage0_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="carriage0"/>
    <origin xyz="-0.08333 -0.30000 0.54000" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.150" upper="0.150" effort="50" velocity="0.5"/>
  </joint>

  <link name="tool0">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="model://weedwatch_robot/tool0.obj"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0060" length="0.1925"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.000000 0.000000 0.000000" rpy="0 0 0"/>
      <mass value="0.5000"/>
      <inertia ixx="0.0015485104" iyy="0.0015485104" izz="9e-06" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="tool0_joint" type="prismatic">
    <parent link="carriage0"/>
    <child link="tool0"/>
    <origin xyz="-0.00667 0.00000 -0.13625" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.350" upper="0" effort="50" velocity="0.3"/>
  </joint>

  <link name="carriage1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="model://weedwatch_robot/carriage1.obj"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.0000 0.0000 0.0000" rpy="0 0 0"/>
      <geometry><box size="0.1400 0.1000 0.1000"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.000000 0.000000 0.000000" rpy="0 0 0"/>
      <mass value="2.0000"/>
      <inertia ixx="0.0033333333" iyy="0.0049333333" izz="0.0049333333" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="carriage1_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="carriage1"/>
    <origin xyz="-0.26333 0.00000 0.54000" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.150" upper="0.150" effort="50" velocity="0.5"/>
  </joint>

  <link name="tool1">
